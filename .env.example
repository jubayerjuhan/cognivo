# Auth — a random secret used to sign session cookies (custom login, no Clerk).
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me
# Set to 1 when Cognivo is served over HTTPS so session cookies get the Secure flag.
# AUTH_COOKIE_SECURE=1

# MongoDB connection string (Atlas, or a local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/cognivo

# Groq — https://console.groq.com/keys (only needed for the AI features)
GROQ_API_KEY=<redacted>
# Optional: override the model
GROQ_MODEL=openai/gpt-oss-120b
